# Copy to .env (gitignored) and fill in only what you need.
# Every variable here is read directly by src/api/main.ts — nothing here is aspirational.

# ---- Demo mode (recommended for local/first-time use) ----
# "true" (exact string) swaps in a disclosed deterministic risk judge and a
# self-built mock payment rail — no external accounts or API keys needed at all.
# See docs/SECURITY_MODEL.md and the README's "Demo Mode" section.
AEGIS_DEMO_MODE=true

# ---- Server ----
# Port to listen on. Defaults to 8787 if unset.
PORT=8787

# ---- Persistence ----
# Path to the SQLite database file. Defaults to ./aegis.db if unset.
AEGIS_DB_PATH=./aegis.db

# ---- Signing keys (persistent deployments only) ----
# Leave both unset for local/demo use — the server generates fresh ephemeral
# keys on every start, which is fine until you restart and want previously
# issued tokens or ledger entries to still verify. Set both to fixed values
# before any deployment you intend to keep running/restarting; the server
# prints ready-to-use freshly-generated values on every startup where these
# are unset, if you want to copy one in. Never commit real values.
AEGIS_ROOT_PRIVATE_KEY_HEX=
AEGIS_LEDGER_PRIVATE_KEY_HEX=

# ---- Only relevant when AEGIS_DEMO_MODE is NOT "true" ----
# Two independent, real intent-consistency judges are supported — set the key(s) for
# whichever you intend to use. Demo mode always wins regardless of what's set here.
#
# A real Anthropic-backed intent-consistency judge.
ANTHROPIC_API_KEY=
# A real Gemini-backed intent-consistency judge (alternative to Anthropic, same role).
# Never commit the actual key; put it only in your local .env file.
GEMINI_API_KEY=
# Which judge to use when NOT in demo mode. Supported values: "anthropic" or "gemini".
# Required only if BOTH keys above are set (Aegis refuses to guess); if only one key
# is set, that one is used automatically and this can stay unset.
AEGIS_RISK_PROVIDER=

# How long (milliseconds) to wait for the intent judge before treating it as
# unavailable — which always ESCALATES the transaction for review, never allows it.
# Leave unset for the provider-aware default: 8000ms for the demo stand-in and
# Anthropic (unchanged), 45000ms when Gemini is selected (Gemini's real observed
# latency is 20-28s — a short timeout would escalate almost every transaction before
# Gemini can respond). Must be a positive whole number if set at all; anything else
# (zero, negative, non-numeric) fails clearly at startup rather than being ignored.
AEGIS_JUDGE_TIMEOUT_MS=

# A real Stripe test-mode rail. Never read at all while AEGIS_DEMO_MODE=true,
# regardless of what this is set to.
STRIPE_SECRET_KEY=
